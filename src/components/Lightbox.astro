---
/**
 * Visionneuse plein écran, partagée par toutes les galeries de la page.
 * Clavier : ← → (Début / Fin), Z ou + / − pour zoomer, D pour télécharger (si autorisé), Échap.
 * Tactile : balayage gauche/droite, vers le bas pour fermer, double-tap pour zoomer.
 * Le bouton « retour » du téléphone ferme la visionneuse, et chaque photo a son adresse (#photo-12).
 */
import Icon from './Icon.astro';
---

<dialog class="lb" data-lightbox aria-label="Visionneuse de photos">
  <div class="lb__bar">
    <p class="lb__counter" aria-live="polite"><b data-lb-current>01</b> / <span data-lb-total>01</span></p>
    <p class="lb__title" data-lb-title></p>
    <div class="lb__tools">
      <button class="lb__button" type="button" data-lb-zoom aria-pressed="false" aria-label="Zoomer" title="Zoomer (Z)">
        <Icon name="zoom" />
      </button>
      <a class="lb__button" data-lb-save hidden aria-label="Télécharger cette photo" title="Télécharger (D)">
        <Icon name="download" />
      </a>
      <button class="lb__button" type="button" data-lb-close aria-label="Fermer la visionneuse" title="Fermer (Échap)">
        <Icon name="close" />
      </button>
    </div>
  </div>

  <div class="lb__stage" data-lb-stage>
    <figure class="lb__frame" data-lb-frame></figure>
  </div>

  <button class="lb__button lb__nav lb__nav--prev" type="button" data-lb-prev aria-label="Photo précédente">
    <Icon name="arrow-left" />
  </button>
  <button class="lb__button lb__nav lb__nav--next" type="button" data-lb-next aria-label="Photo suivante">
    <Icon name="arrow-right" />
  </button>

  <div class="lb__foot">
    <p class="lb__caption" data-lb-caption></p>
    <p class="lb__keys" aria-hidden="true"><kbd>←</kbd><kbd>→</kbd> naviguer <kbd>Z</kbd> zoomer <kbd>Échap</kbd> fermer</p>
  </div>
</dialog>

<style>
  .lb {
    --lb-bar: 4.25rem;
    --lb-foot: 3.75rem;
    --lb-side: 0px;
    position: fixed;
    inset: 0;
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: env(safe-area-inset-top, 0px) env(safe-area-inset-right, 0px) env(safe-area-inset-bottom, 0px) env(safe-area-inset-left, 0px);
    border: 0;
    overflow: hidden;
    background: #060608;
    color: var(--text);
    opacity: 0;
    transition: opacity 0.3s var(--ease);
  }
  .lb::backdrop {
    background: transparent;
  }
  .lb.is-open {
    opacity: 1;
  }
  .lb.is-dragging {
    transition: none;
  }

  .lb__bar {
    position: absolute;
    inset: env(safe-area-inset-top, 0px) env(safe-area-inset-right, 0px) auto env(safe-area-inset-left, 0px);
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 1rem;
    height: var(--lb-bar);
    padding-inline: max(1rem, 2vw);
  }
  .lb__counter {
    flex: none;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.14em;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
  }
  .lb__counter b {
    font-weight: 500;
    color: var(--accent);
  }
  .lb__title {
    min-width: 0;
    overflow: hidden;
    font-size: 0.8125rem;
    color: var(--muted);
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .lb__tools {
    display: flex;
    gap: 0.5rem;
    margin-left: auto;
  }
  .lb__button {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.04);
    color: var(--text);
    transition:
      background-color 0.2s var(--ease),
      border-color 0.2s var(--ease),
      opacity 0.2s var(--ease);
  }
  .lb__button :global(svg) {
    width: 1.2rem;
    height: 1.2rem;
  }
  .lb__button:hover {
    border-color: var(--accent);
    background: rgba(226, 84, 58, 0.14);
  }
  .lb__button[aria-pressed='true'] {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-ink);
  }
  .lb__button[disabled] {
    opacity: 0.25;
    pointer-events: none;
  }
  .lb__button[hidden] {
    display: none;
  }

  .lb__stage {
    position: absolute;
    inset: calc(var(--lb-bar) + env(safe-area-inset-top, 0px)) var(--lb-side) calc(var(--lb-foot) + env(safe-area-inset-bottom, 0px));
    display: grid;
    place-items: center;
    overflow: hidden;
    touch-action: pinch-zoom;
    cursor: zoom-out;
  }
  .lb.is-zoomed .lb__stage {
    touch-action: none;
  }
  .lb__frame {
    --r: 1.5;
    --w: 4000;
    position: relative;
    /* Le plus grand rectangle aux proportions de la photo qui tient dans la scène */
    width: min(100vw - var(--lb-side) * 2, (100dvh - var(--lb-bar) - var(--lb-foot) - env(safe-area-inset-top, 0px) - env(safe-area-inset-bottom, 0px)) * var(--r), var(--w) * 1px);
    aspect-ratio: var(--r);
    background-position: center;
    background-size: cover;
    cursor: zoom-in;
    transition:
      transform 0.4s var(--ease-out),
      opacity 0.3s var(--ease);
    will-change: transform;
  }
  .lb.is-zoomed .lb__frame {
    cursor: grab;
  }
  .lb.is-dragging .lb__frame,
  .lb.is-panning .lb__frame {
    transition: none;
  }
  .lb.is-panning .lb__frame {
    cursor: grabbing;
  }
  .lb__frame :global(picture),
  .lb__frame :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .lb__frame :global(img) {
    object-fit: contain;
    opacity: 0;
    transition: opacity 0.4s ease;
    -webkit-user-drag: none;
    user-select: none;
  }
  .lb__frame :global(img.is-loaded) {
    opacity: 1;
  }

  .lb__nav {
    position: absolute;
    bottom: calc(0.5rem + env(safe-area-inset-bottom, 0px));
    z-index: 2;
  }
  .lb__nav--prev {
    left: max(1rem, 2vw);
  }
  .lb__nav--next {
    right: max(1rem, 2vw);
  }

  .lb__foot {
    position: absolute;
    inset: auto 4.5rem env(safe-area-inset-bottom, 0px);
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.25rem 1.5rem;
    min-height: var(--lb-foot);
    padding-block: 0.5rem;
    font-size: 0.8125rem;
    text-align: center;
    color: var(--muted);
  }
  .lb__caption {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.15rem 1rem;
  }
  .lb__caption:empty {
    display: none;
  }
  .lb__caption :global(a) {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.25em;
    white-space: nowrap;
  }
  .lb__keys {
    display: none;
  }
  .lb__keys kbd {
    margin-inline: 0.15rem;
    padding: 0.1rem 0.4rem;
    border: 1px solid var(--line);
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text);
  }

  @media (min-width: 900px) {
    .lb {
      --lb-side: 5.5rem;
    }
    .lb__nav {
      top: 50%;
      bottom: auto;
      width: 3.375rem;
      height: 3.375rem;
      margin-top: -1.7rem;
    }
    .lb__keys {
      display: block;
    }
  }
  @media (max-width: 560px) {
    .lb__title {
      display: none;
    }
  }
</style>

<script>
  interface Item {
    el: HTMLAnchorElement;
    href: string;
    srcset: string;
    srcsetAvif?: string;
    w: number;
    h: number;
    alt: string;
    color: string;
    caption?: string;
    link?: string;
    linkLabel?: string;
    download?: string;
    downloadName?: string;
  }

  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');

  if (dialog && typeof dialog.showModal === 'function') {
    const stage = dialog.querySelector<HTMLElement>('[data-lb-stage]')!;
    const frame = dialog.querySelector<HTMLElement>('[data-lb-frame]')!;
    const captionEl = dialog.querySelector<HTMLElement>('[data-lb-caption]')!;
    const titleEl = dialog.querySelector<HTMLElement>('[data-lb-title]')!;
    const zoomButton = dialog.querySelector<HTMLButtonElement>('[data-lb-zoom]')!;
    const downloadLink = dialog.querySelector<HTMLAnchorElement>("[data-lb-save]")!;
    const currentEl = dialog.querySelector<HTMLElement>('[data-lb-current]')!;
    const totalEl = dialog.querySelector<HTMLElement>('[data-lb-total]')!;
    const prevButton = dialog.querySelector<HTMLButtonElement>('[data-lb-prev]')!;
    const nextButton = dialog.querySelector<HTMLButtonElement>('[data-lb-next]')!;
    const closeButton = dialog.querySelector<HTMLButtonElement>('[data-lb-close]')!;

    let items: Item[] = [];
    let index = 0;
    let isOpen = false;
    let pushedState = false;
    let closing = false;
    let token = 0;
    let avifSupported: boolean | null = null;
    let opener: HTMLElement | null = null;

    const pad = (n: number) => String(n).padStart(2, '0');

    // ----- Zoom : ×2,5 centré sur le point cliqué, puis glisser pour se déplacer -----
    const ZOOM = 2.5;
    let zoomed = false;
    let panX = 0;
    let panY = 0;

    const clampPan = () => {
      const rect = frame.getBoundingClientRect();
      const baseW = rect.width / (zoomed ? ZOOM : 1);
      const baseH = rect.height / (zoomed ? ZOOM : 1);
      const maxX = (baseW * (ZOOM - 1)) / 2;
      const maxY = (baseH * (ZOOM - 1)) / 2;
      panX = Math.max(-maxX, Math.min(maxX, panX));
      panY = Math.max(-maxY, Math.min(maxY, panY));
    };
    const applyZoom = () => {
      frame.style.transform = zoomed ? `translate3d(${panX}px, ${panY}px, 0) scale(${ZOOM})` : '';
      dialog.classList.toggle('is-zoomed', zoomed);
      zoomButton.setAttribute('aria-pressed', String(zoomed));
      zoomButton.setAttribute('aria-label', zoomed ? 'Dézoomer' : 'Zoomer');
    };
    const setZoom = (on: boolean, clientX?: number, clientY?: number) => {
      if (on === zoomed) return;
      zoomed = on;
      panX = panY = 0;
      if (on) {
        // Charge la meilleure définition disponible pour le zoom.
        const img = frame.querySelector('img');
        const width = Math.round(frame.getBoundingClientRect().width * ZOOM);
        frame.querySelectorAll('source, img').forEach((el) => el.setAttribute('sizes', `${width}px`));
        if (img && clientX !== undefined && clientY !== undefined) {
          const rect = frame.getBoundingClientRect();
          panX = (rect.left + rect.width / 2 - clientX) * (ZOOM - 1);
          panY = (rect.top + rect.height / 2 - clientY) * (ZOOM - 1);
          zoomed = true;
          clampPan();
        }
      }
      applyZoom();
    };
    const hashFor = (i: number) => `#photo-${i + 1}`;
    const cleanUrl = () => location.pathname + location.search;

    const collect = (group: string): Item[] =>
      [...document.querySelectorAll<HTMLAnchorElement>(`a[data-lb="${CSS.escape(group)}"]`)]
        .sort((a, b) => Number(a.dataset.lbIndex) - Number(b.dataset.lbIndex))
        .map((el) => ({
          el,
          href: el.href,
          srcset: el.dataset.lbSrcset ?? '',
          srcsetAvif: el.dataset.lbSrcsetAvif,
          w: Number(el.dataset.lbW) || 3,
          h: Number(el.dataset.lbH) || 2,
          alt: el.querySelector('img')?.alt ?? '',
          color: el.dataset.lbColor ?? '#111',
          caption: el.dataset.lbCaption,
          link: el.dataset.lbLink,
          linkLabel: el.dataset.lbLinkLabel,
          download: el.dataset.lbDownload,
          downloadName: el.dataset.lbDownloadName,
        }));

    const thumbSrc = (item: Item) => item.el.querySelector('img')?.currentSrc ?? '';

    /** Précharge la photo voisine dans le format que le navigateur utilisera réellement. */
    const preload = (i: number) => {
      const item = items[i];
      if (!item) return;
      const image = new Image();
      image.decoding = 'async';
      image.sizes = `${Math.round(frame.getBoundingClientRect().width) || window.innerWidth}px`;
      image.srcset = avifSupported && item.srcsetAvif ? item.srcsetAvif : item.srcset;
    };

    const show = (next: number) => {
      index = (next + items.length) % items.length;
      const item = items[index];
      const current = ++token;

      if (avifSupported === null) avifSupported = /\.avif(\?|$)/.test(thumbSrc(item));

      frame.style.setProperty('--r', String(item.w / item.h));
      frame.style.setProperty('--w', String(item.w));
      frame.style.backgroundColor = item.color;
      frame.style.backgroundImage = thumbSrc(item) ? `url("${thumbSrc(item)}")` : 'none';
      zoomed = false;
      panX = panY = 0;
      applyZoom();

      // Nouvelle balise à chaque photo : l'ancienne image ne s'affiche jamais dans le mauvais cadre.
      const picture = document.createElement('picture');
      const sizes = `${Math.round(frame.getBoundingClientRect().width) || window.innerWidth}px`;
      if (item.srcsetAvif) {
        const source = document.createElement('source');
        source.type = 'image/avif';
        source.sizes = sizes;
        source.srcset = item.srcsetAvif;
        picture.append(source);
      }
      const img = document.createElement('img');
      img.alt = item.alt;
      img.width = item.w;
      img.height = item.h;
      img.decoding = 'async';
      img.draggable = false;
      img.sizes = sizes;
      const reveal = () => {
        if (current === token) img.classList.add('is-loaded');
      };
      img.addEventListener('load', reveal, { once: true });
      img.addEventListener('error', reveal, { once: true });
      if (item.srcset) img.srcset = item.srcset;
      img.src = item.href;
      picture.append(img);
      frame.replaceChildren(picture);
      if (img.complete && img.naturalWidth) reveal();

      currentEl.textContent = pad(index + 1);
      totalEl.textContent = pad(items.length);

      titleEl.textContent = document.querySelector<HTMLElement>('[data-lb-heading]')?.dataset.lbHeading ?? '';
      if (item.download) {
        downloadLink.href = item.download;
        downloadLink.download = item.downloadName || '';
        downloadLink.hidden = false;
      } else {
        downloadLink.removeAttribute('href');
        downloadLink.hidden = true;
      }

      captionEl.replaceChildren();
      if (item.caption) captionEl.append(Object.assign(document.createElement('span'), { textContent: item.caption }));
      if (item.link) {
        captionEl.append(Object.assign(document.createElement('a'), { href: item.link, textContent: item.linkLabel || 'Voir l’événement' }));
      }

      const single = items.length < 2;
      prevButton.disabled = single;
      nextButton.disabled = single;

      if (isOpen) history.replaceState({ lightbox: true }, '', hashFor(index));
      preload(index + 1);
      preload(index - 1);
    };

    const open = (group: string, start: number, fromHistory = false) => {
      items = collect(group);
      if (!items.length) return;
      opener = document.activeElement as HTMLElement | null;
      dialog.dataset.group = group;
      dialog.showModal();
      document.body.classList.add('is-locked');
      isOpen = true;
      if (!fromHistory) {
        history.pushState({ lightbox: true }, '', hashFor(start));
        pushedState = true;
      }
      show(start);
      requestAnimationFrame(() => dialog.classList.add('is-open'));
      closeButton.focus({ preventScroll: true });
    };

    const finishClose = () => {
      if (!isOpen) return;
      isOpen = false;
      closing = false;
      token++;
      dialog.classList.remove('is-open', 'is-dragging', 'is-zoomed', 'is-panning');
      zoomed = false;
      document.body.classList.remove('is-locked');
      const target = items[index]?.el ?? opener;
      window.setTimeout(() => {
        if (dialog.open) dialog.close();
        frame.replaceChildren();
        frame.style.backgroundImage = 'none';
        dialog.style.opacity = '';
        // La page suit la visionneuse : on retrouve la dernière photo vue dans la grille.
        target?.focus({ preventScroll: true });
        target?.scrollIntoView({ block: 'nearest' });
      }, 200);
    };

    const close = () => {
      if (!isOpen || closing) return;
      closing = true;
      if (pushedState) {
        pushedState = false;
        history.back(); // déclenche popstate → finishClose
      } else {
        history.replaceState(null, '', cleanUrl());
        finishClose();
      }
    };

    window.addEventListener('popstate', (event) => {
      if (isOpen) {
        pushedState = false;
        finishClose();
      } else if (event.state?.lightbox) {
        const match = location.hash.match(/^#photo-(\d+)$/);
        const group = dialog.dataset.group;
        if (match && group) {
          pushedState = true;
          open(group, Number(match[1]) - 1, true);
        }
      }
    });

    // Ouverture au clic sur une miniature
    document.addEventListener('click', (event) => {
      const link = (event.target as HTMLElement).closest<HTMLAnchorElement>('a[data-lb]');
      if (!link || event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      open(link.dataset.lb as string, Number(link.dataset.lbIndex) || 0);
    });

    prevButton.addEventListener('click', () => show(index - 1));
    nextButton.addEventListener('click', () => show(index + 1));
    closeButton.addEventListener('click', close);
    stage.addEventListener('click', (event) => {
      if (event.target === stage) {
        if (zoomed) setZoom(false);
        else close();
      }
    });
    zoomButton.addEventListener('click', () => setZoom(!zoomed));

    // Clic sur la photo : zoom à cet endroit ; glisser pour se déplacer une fois zoomé.
    let pointer: { id: number; x: number; y: number; px: number; py: number; moved: boolean } | null = null;
    frame.addEventListener('pointerdown', (event) => {
      if (event.pointerType === 'touch' && !zoomed) return;
      pointer = { id: event.pointerId, x: event.clientX, y: event.clientY, px: panX, py: panY, moved: false };
      if (zoomed) frame.setPointerCapture(event.pointerId);
    });
    frame.addEventListener('pointermove', (event) => {
      if (!pointer || pointer.id !== event.pointerId || !zoomed) return;
      const dx = event.clientX - pointer.x;
      const dy = event.clientY - pointer.y;
      if (!pointer.moved && Math.hypot(dx, dy) < 4) return;
      pointer.moved = true;
      dialog.classList.add('is-panning');
      panX = pointer.px + dx;
      panY = pointer.py + dy;
      clampPan();
      applyZoom();
    });
    const endPointer = (event: PointerEvent) => {
      if (!pointer || pointer.id !== event.pointerId) return;
      const { moved } = pointer;
      pointer = null;
      dialog.classList.remove('is-panning');
      if (event.type === 'pointerup' && !moved && event.pointerType !== 'touch') setZoom(!zoomed, event.clientX, event.clientY);
    };
    frame.addEventListener('pointerup', endPointer);
    frame.addEventListener('pointercancel', endPointer);

    // Double-tap (tactile) : zoom / dézoom.
    let lastTap = 0;
    frame.addEventListener('touchend', (event) => {
      if (event.changedTouches.length !== 1) return;
      const now = Date.now();
      if (now - lastTap < 300) {
        const touch = event.changedTouches[0];
        setZoom(!zoomed, touch.clientX, touch.clientY);
        lastTap = 0;
        event.preventDefault();
      } else lastTap = now;
    });
    // Échap est géré par le raccourci clavier ci-dessous (dézoome d'abord, puis ferme).
    dialog.addEventListener('cancel', (event) => event.preventDefault());
    dialog.addEventListener('keydown', (event) => {
      if (event.metaKey || event.ctrlKey || event.altKey) return;
      if (event.key === 'Escape') {
        if (zoomed) setZoom(false);
        else close();
      } else if (event.key === 'ArrowRight') show(index + 1);
      else if (event.key === 'ArrowLeft') show(index - 1);
      else if (event.key === 'z' || event.key === 'Z') setZoom(!zoomed);
      else if (event.key === '+' || event.key === '=') setZoom(true);
      else if (event.key === '-') setZoom(false);
      else if ((event.key === 'd' || event.key === 'D') && !downloadLink.hidden) downloadLink.click();
      else if (event.key === 'Home') show(0);
      else if (event.key === 'End') show(items.length - 1);
      else return;
      event.preventDefault();
    });

    // ----- Tactile : balayer pour naviguer, tirer vers le bas pour fermer -----
    const isZoomed = () => (window.visualViewport?.scale ?? 1) > 1.02;
    window.visualViewport?.addEventListener('resize', () => dialog.classList.toggle('is-zoomed', isZoomed()));

    let startX = 0;
    let startY = 0;
    let dx = 0;
    let dy = 0;
    let axis: 'x' | 'y' | null = null;
    let tracking = false;

    const resetDrag = () => {
      tracking = false;
      axis = null;
      dialog.classList.remove('is-dragging');
      if (!zoomed) frame.style.transform = '';
      dialog.style.opacity = '';
    };

    stage.addEventListener(
      'touchstart',
      (event) => {
        if (event.touches.length !== 1 || isZoomed() || zoomed) return resetDrag();
        tracking = true;
        axis = null;
        dx = dy = 0;
        startX = event.touches[0].clientX;
        startY = event.touches[0].clientY;
      },
      { passive: true },
    );

    stage.addEventListener(
      'touchmove',
      (event) => {
        if (!tracking) return;
        if (event.touches.length !== 1) return resetDrag();
        dx = event.touches[0].clientX - startX;
        dy = event.touches[0].clientY - startY;
        if (!axis && Math.hypot(dx, dy) > 10) axis = Math.abs(dx) > Math.abs(dy) ? 'x' : 'y';
        if (!axis) return;
        dialog.classList.add('is-dragging');
        if (axis === 'x') {
          frame.style.transform = `translate3d(${dx}px, 0, 0)`;
        } else if (dy > 0) {
          frame.style.transform = `translate3d(0, ${dy}px, 0) scale(${1 - Math.min(dy / 1600, 0.12)})`;
          dialog.style.opacity = String(1 - Math.min(dy / 600, 0.55));
        }
      },
      { passive: true },
    );

    const endDrag = () => {
      if (!tracking) return;
      const moved = { axis, dx, dy };
      resetDrag();
      if (moved.axis === 'x' && Math.abs(moved.dx) > 56 && items.length > 1) show(index + (moved.dx < 0 ? 1 : -1));
      else if (moved.axis === 'y' && moved.dy > 110) close();
    };
    stage.addEventListener('touchend', endDrag, { passive: true });
    stage.addEventListener('touchcancel', resetDrag, { passive: true });

    // Lien direct vers une photo : …/evenements/mon-evenement/#photo-12
    const openFromHash = () => {
      const direct = location.hash.match(/^#photo-(\d+)$/);
      const group = document.querySelector<HTMLAnchorElement>('a[data-lb]')?.dataset.lb;
      if (!direct || !group || isOpen) return;
      const start = Math.min(Math.max(Number(direct[1]) - 1, 0), collect(group).length - 1);
      history.replaceState({ lightbox: true }, '', hashFor(start));
      open(group, start, true);
    };
    openFromHash();
    window.addEventListener('hashchange', openFromHash);
  }
</script>
