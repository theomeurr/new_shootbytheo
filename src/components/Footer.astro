---
import { CONTACT_LINK, NAV, instagram, site } from '@/lib/site';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__inner">
    <a class="footer__logo" href="/" aria-label={`${site.name} — accueil`}>
      <img src={site.logo} alt="" width="527" height="400" loading="lazy" />
    </a>
    <nav class="footer__nav" aria-label="Pied de page">
      {NAV.map((item) => <a href={item.href}>{item.label}</a>)}
      <a href={CONTACT_LINK.href}>{CONTACT_LINK.label}</a>
      {
        instagram && (
          <a href={instagram.url} target="_blank" rel="noopener">
            Instagram
          </a>
        )
      }
      <a href="/mentions-legales/">Mentions légales</a>
    </nav>
    <p class="footer__rights">© {year} Théo Meurier</p>
  </div>
</footer>

<style>
  .footer {
    margin-top: auto;
    border-top: 1px solid var(--line);
    padding-block: 2.75rem calc(2.75rem + env(safe-area-inset-bottom, 0px));
  }
  .footer__inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1.75rem;
  }
  .footer__logo img {
    width: auto;
    height: 3.25rem;
  }
  .footer__nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.6rem;
    font-size: 0.8125rem;
  }
  .footer__nav a {
    color: var(--muted);
    transition: color 0.2s var(--ease);
  }
  .footer__nav a:hover {
    color: var(--text);
  }
  .footer__rights {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  @media (max-width: 760px) {
    .footer__inner {
      grid-template-columns: 1fr;
      justify-items: start;
    }
    .footer__nav {
      justify-content: flex-start;
    }
  }
</style>
