---
import Brand from './Brand.astro';
import Icon from './Icon.astro';
import { instagram, site } from '@/lib/site';

interface Props {
  /** Une seule ligne, sans le bloc de marque : utilisé sous l'image à la une de l'accueil. */
  compact?: boolean;
}

const { compact = false } = Astro.props;
const year = new Date().getFullYear();
---

<footer class:list={['footer', compact && 'footer--compact']}>
  <div class="container">
    {
      !compact && (
        <div class="footer__top">
          <div class="footer__brand">
            <Brand />
            <p class="meta">{site.tagline}</p>
          </div>
          <ul class="footer__links">
            {instagram && (
              <li>
                <a class="footer__link" href={instagram.url} target="_blank" rel="noopener">
                  Instagram <Icon name="arrow-up-right" />
                </a>
              </li>
            )}
            <li>
              <a class="footer__link" href="/contact/">
                Contact <Icon name="arrow-right" />
              </a>
            </li>
          </ul>
        </div>
      )
    }

    <div class="footer__bottom">
      <span>© {year} Théo Meurier</span>
      <a href={`mailto:${site.email}`}>{site.email}</a>
      {instagram && <a href={instagram.url} target="_blank" rel="noopener">{instagram.handle}</a>}
    </div>
  </div>
</footer>

<style>
  .footer {
    margin-top: auto;
    border-top: 1px solid var(--line);
    background: var(--bg);
  }
  .footer__top {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    padding-block: clamp(2.5rem, 5vw, 4.5rem);
  }
  .footer__brand {
    display: grid;
    gap: 0.9rem;
  }
  .footer__brand :global(.brand) {
    font-size: clamp(1.3rem, 2.25vw, 2.2rem);
  }
  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2.25rem;
  }
  .footer__link {
    display: inline-flex;
    align-items: center;
    gap: 0.7em;
    padding-block: 0.6rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition: color 0.3s var(--ease);
  }
  .footer__link :global(svg) {
    width: 1.4em;
    height: 1.4em;
    color: var(--accent);
    transition: transform 0.4s var(--ease-out);
  }
  .footer__link:hover {
    color: var(--accent-bright);
  }
  .footer__link:hover :global(svg) {
    transform: translate(0.2em, -0.1em);
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-block: 1.6rem calc(1.6rem + env(safe-area-inset-bottom));
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .footer__bottom a {
    transition: color 0.3s var(--ease);
  }
  .footer__bottom a:hover {
    color: var(--text);
  }
  /* Accueil : une seule ligne discrète sous l'image à la une */
  .footer--compact {
    border-top-color: transparent;
  }
  .footer--compact .footer__bottom {
    border-top: 0;
    padding-block: 1.35rem calc(1.35rem + env(safe-area-inset-bottom));
  }
</style>
