---
/** Carte de reportage : couverture 4:3, catégorie en pastille, date · lieu · nombre de photos, titre. */
import Icon from './Icon.astro';
import Picture from './Picture.astro';
import type { SiteEvent } from '@/lib/events';
import { formatShortDate, keepBullet } from '@/lib/dates';

interface Props {
  event: SiteEvent;
  sizes?: string;
  heading?: 'h2' | 'h3';
  priority?: boolean;
}

const { event, heading: Heading = 'h3', priority = false } = Astro.props;
const sizes = Astro.props.sizes ?? '(min-width: 1100px) 30vw, (min-width: 640px) 46vw, 100vw';
const count = event.photos.length;
---

<a class="card" href={event.url} data-card data-category={event.category?.id ?? ''} data-date={event.isoDate} data-reveal>
  <div class="card__media">
    {
      event.cover ? (
        <Picture photo={event.cover} alt="" sizes={sizes} cover position={event.coverPosition} priority={priority} max={1440} />
      ) : (
        <div class="card__empty" />
      )
    }
    {event.competition && <span class="card__tag">{event.competition}</span>}
    <span class="card__go" aria-hidden="true"><Icon name="arrow-right" /></span>
  </div>
  <div class="card__text">
    <p class="card__meta">
      <time datetime={event.isoDate}>{formatShortDate(event.date)}</time>
      {event.location && <span>· {event.location}</span>}
      {count > 0 && <span class="card__count">· {count} photo{count > 1 ? 's' : ''}</span>}
    </p>
    <Heading class="card__title">{keepBullet(event.title)}</Heading>
  </div>
</a>

<style>
  .card {
    display: grid;
    gap: 1rem;
    min-width: 0;
  }
  .card__media {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg-soft);
    isolation: isolate;
  }
  .card__media::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.06);
    pointer-events: none;
  }
  .card__media :global(img) {
    transition:
      transform 1s var(--ease),
      opacity 0.8s ease;
  }
  .card__empty {
    width: 100%;
    height: 100%;
  }
  .card__tag {
    position: absolute;
    top: 0.875rem;
    left: 0.875rem;
    padding: 0.375rem 0.7rem;
    border-radius: 999px;
    background: rgba(11, 11, 13, 0.72);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .card__go {
    position: absolute;
    right: 0.875rem;
    bottom: 0.875rem;
    display: grid;
    place-items: center;
    width: 2.875rem;
    height: 2.875rem;
    border-radius: 50%;
    background: var(--accent);
    color: var(--accent-ink);
    opacity: 0;
    transform: translateY(10px) scale(0.9);
    transition:
      opacity 0.35s var(--ease),
      transform 0.35s var(--ease);
  }
  .card__go :global(svg) {
    width: 1.2rem;
    height: 1.2rem;
  }
  .card__text {
    display: grid;
    gap: 0.375rem;
  }
  .card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .card__count {
    color: var(--text);
  }
  .card__title {
    font-weight: 700;
    font-stretch: 104%;
    font-size: clamp(1.25rem, 1.7vw, 1.6rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
    text-wrap: balance;
    transition: color 0.25s var(--ease);
  }
  @media (hover: hover) {
    .card:hover .card__media :global(img) {
      transform: scale(1.06);
    }
    .card:hover .card__title {
      color: var(--accent);
    }
    .card:hover .card__go {
      opacity: 1;
      transform: none;
    }
  }
  .card:focus-visible .card__go {
    opacity: 1;
    transform: none;
  }
</style>
