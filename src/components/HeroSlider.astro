---
/**
 * Image à la une : une petite vignette centrée, avec des flèches de part et
 * d'autre quand il y a plusieurs événements à la une. Pas de défilement automatique.
 */
import Icon from './Icon.astro';
import Picture from './Picture.astro';
import type { SiteEvent } from '@/lib/events';
import type { Photo } from '@/lib/media';
import { site } from '@/lib/site';

export interface Slide {
  photo: Photo;
  position: string;
  event?: SiteEvent;
}

interface Props {
  slides: Slide[];
}

const { slides } = Astro.props;
const many = slides.length > 1;
---

<section class="hero" data-hero aria-roledescription="carrousel" aria-label="À la une">
  <div class="hero__frame">
    {
      many && (
        <button class="hero__arrow" type="button" data-hero-prev aria-label="Image précédente">
          <Icon name="arrow-left" />
        </button>
      )
    }
    <div class="hero__slides">
      {
        slides.map((slide, index) => (
          <div class:list={['hero__slide', index === 0 && 'is-active']} data-hero-slide aria-hidden={index === 0 ? undefined : 'true'}>
            <Picture
              photo={slide.photo}
              alt={slide.event ? `${slide.event.seoTitle} — photo ShootByTheo` : 'Photographie sportive ShootByTheo'}
              sizes="90vw"
              fit
              priority={index === 0}
              deferred={index > 0}
            />
          </div>
        ))
      }
    </div>
    {
      many && (
        <button class="hero__arrow" type="button" data-hero-next aria-label="Image suivante">
          <Icon name="arrow-right" />
        </button>
      )
    }
  </div>
  <div class="hero__shade" aria-hidden="true"></div>

  <div class="hero__inner">
    <div class="hero__content">
      <p class="kicker hero__kicker">{site.tagline}</p>
      <h1 class="sr-only">{site.name}, photographe et vidéaste sportif.</h1>
      <div class="hero__actions">
        <a class="btn btn--ghost" href="/contact/">Me contacter</a>
      </div>
    </div>

    <div class="hero__aside">
      <div class="hero__captions">
        {
          slides.map((slide, index) =>
            slide.event ? (
              <a class:list={['hero__caption', index === 0 && 'is-active']} href={slide.event.url} data-hero-caption tabindex={index === 0 ? undefined : -1}>
                <span class="meta">À la une<span class="hero__caption-date"> · {slide.event.dateLabel}</span></span>
                <span class="hero__caption-title">
                  {slide.event.title}
                  {slide.event.location && ` — ${slide.event.location}`}
                  <Icon name="arrow-up-right" />
                </span>
              </a>
            ) : (
              <span class:list={['hero__caption', index === 0 && 'is-active']} data-hero-caption />
            ),
          )
        }
      </div>

    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    flex: 1 0 auto;
    min-height: 38rem;
    overflow: hidden;
    background: var(--bg);
    isolation: isolate;
  }
  .hero__frame {
    position: absolute;
    top: calc(var(--header-h) + 1.5rem);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 2.5vw, 1.75rem);
  }
  .hero__slides {
    position: relative;
    width: min(72vw, 34rem);
    aspect-ratio: 3 / 2;
  }
  .hero__shade {
    position: absolute;
    top: calc(var(--header-h) + 1.5rem);
    left: 50%;
    transform: translateX(-50%);
    width: min(72vw, 34rem);
    aspect-ratio: 3 / 2;
  }
  .hero__slide {
    position: absolute;
    inset: 0;
  }
  .hero__slide {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 1.4s var(--ease),
      visibility 0s linear 1.4s;
  }
  .hero__slide.is-active {
    opacity: 1;
    visibility: visible;
    transition:
      opacity 1.4s var(--ease),
      visibility 0s;
  }
  .hero__shade {
    background:
      linear-gradient(to top, rgba(10, 10, 11, 0.94) 0%, rgba(10, 10, 11, 0.55) 26%, rgba(10, 10, 11, 0) 58%),
      linear-gradient(to right, rgba(10, 10, 11, 0.35), rgba(10, 10, 11, 0) 55%);
  }

  .hero__inner {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: end;
    gap: 1.75rem;
    padding: calc(var(--header-h) + 1rem) var(--edge) calc(1.5rem + env(safe-area-inset-bottom));
    /* Ne couvre que son contenu (en bas) : laisse passer les clics vers les flèches de l'image. */
    pointer-events: none;
  }
  .hero__content,
  .hero__aside {
    pointer-events: auto;
  }

  .hero__content {
    display: grid;
    gap: clamp(1rem, 1.6vw, 1.75rem);
    justify-items: start;
    container-type: inline-size;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.35rem;
  }

  .hero__aside {
    display: grid;
  }
  .hero__captions {
    display: grid;
    min-width: 0;
  }
  .hero__caption {
    grid-area: 1 / 1;
    display: grid;
    gap: 0.3rem;
    min-width: 0;
    opacity: 0;
    visibility: hidden;
    transform: translate3d(0, 0.5rem, 0);
    transition:
      opacity 0.6s var(--ease),
      transform 0.6s var(--ease-out),
      visibility 0s linear 0.6s;
  }
  .hero__caption.is-active {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition:
      opacity 0.6s var(--ease) 0.25s,
      transform 0.6s var(--ease-out) 0.25s,
      visibility 0s;
  }
  .hero__caption-title {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.35;
    color: var(--text);
  }
  .hero__caption-title :global(svg) {
    flex: none;
    width: 1.1em;
    height: 1.1em;
    color: var(--accent);
    transition: transform 0.4s var(--ease-out);
  }
  .hero__caption:hover .hero__caption-title :global(svg) {
    transform: translate(0.15em, -0.15em);
  }

  @media (max-width: 699px) {
    .hero__caption-date {
      display: none;
    }
  }
  .hero__arrow {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid rgba(243, 239, 233, 0.4);
    border-radius: 50%;
    transition:
      background-color 0.3s var(--ease),
      border-color 0.3s var(--ease),
      color 0.3s var(--ease);
  }
  .hero__arrow :global(svg) {
    width: 1.15rem;
    height: 1.15rem;
  }
  .hero__arrow:hover {
    background: var(--text);
    border-color: var(--text);
    color: var(--bg);
  }

  @media (min-width: 1000px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      gap: 2.25rem 3rem;
      padding-bottom: 2rem;
    }
    .hero__aside {
      justify-items: end;
      max-width: 24rem;
    }
    .hero__caption {
      justify-items: end;
      text-align: right;
    }
  }

  @media (max-height: 560px) and (orientation: landscape) {
    .hero__kicker {
      display: none;
    }
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]');

  if (hero) {
    const slides = [...hero.querySelectorAll<HTMLElement>('[data-hero-slide]')];
    const captions = [...hero.querySelectorAll<HTMLElement>('[data-hero-caption]')];
    let index = 0;

    /** Les diapositives suivantes ne sont téléchargées qu'au moment utile. */
    const hydrate = (slide: HTMLElement | undefined) => {
      slide?.querySelectorAll<HTMLElement>('[data-srcset], [data-src]').forEach((node) => {
        if (node.dataset.srcset) node.setAttribute('srcset', node.dataset.srcset);
        if (node.dataset.src) node.setAttribute('src', node.dataset.src);
        delete node.dataset.srcset;
        delete node.dataset.src;
      });
    };

    const goTo = (next: number) => {
      const target = (next + slides.length) % slides.length;
      if (target === index) return;
      hydrate(slides[target]);
      index = target;

      slides.forEach((slide, i) => {
        slide.classList.toggle('is-active', i === index);
        slide.toggleAttribute('aria-hidden', i !== index);
        if (i !== index) slide.setAttribute('aria-hidden', 'true');
      });
      captions.forEach((caption, i) => {
        caption.classList.toggle('is-active', i === index);
        if (caption instanceof HTMLAnchorElement) caption.tabIndex = i === index ? 0 : -1;
      });
      hydrate(slides[(index + 1) % slides.length]);
    };

    if (slides.length > 1) {
      hero.querySelector('[data-hero-next]')?.addEventListener('click', () => goTo(index + 1));
      hero.querySelector('[data-hero-prev]')?.addEventListener('click', () => goTo(index - 1));

      // Balayage tactile
      let startX = 0;
      let startY = 0;
      hero.addEventListener(
        'touchstart',
        (event) => {
          startX = event.touches[0].clientX;
          startY = event.touches[0].clientY;
        },
        { passive: true },
      );
      hero.addEventListener(
        'touchend',
        (event) => {
          const dx = event.changedTouches[0].clientX - startX;
          const dy = event.changedTouches[0].clientY - startY;
          if (Math.abs(dx) > 48 && Math.abs(dx) > Math.abs(dy) * 1.5) goTo(index + (dx < 0 ? 1 : -1));
        },
        { passive: true },
      );

      // La deuxième image est préparée une fois la page chargée.
      const warmUp = () => hydrate(slides[1]);
      if (document.readyState === 'complete') warmUp();
      else window.addEventListener('load', warmUp, { once: true });
    }
  }
</script>
