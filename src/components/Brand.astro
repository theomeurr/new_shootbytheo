---
/** Signature ShootByTheo : logo image si "logo" est renseigné dans content/site.json, sinon le mot-symbole. */
import { site } from '@/lib/site';

interface Props {
  class?: string;
  /** Logo nettement plus grand (utilisé dans l'en-tête). */
  large?: boolean;
}
const { class: className, large = false } = Astro.props;
---

<a class:list={['brand', large && 'brand--large', className]} href="/" aria-label={`${site.name} — retour à l’accueil`}>
  {site.logo ? <img src={site.logo} alt="" height={large ? '160' : '40'} /> : <span aria-hidden="true">Shoot<i>by</i>Theo</span>}
</a>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    font-weight: 900;
    font-size: clamp(1rem, 0.35vw + 0.92rem, 1.3rem);
    line-height: 1;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: var(--text);
  }
  .brand i {
    font-style: normal;
    color: var(--accent);
  }
  .brand img {
    height: clamp(2rem, 3vw, 2.75rem);
    width: auto;
  }
  .brand--large img {
    height: clamp(6rem, 9vw, 9.5rem);
    transition: height 0.45s var(--ease-out);
  }
</style>
