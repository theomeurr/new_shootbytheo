---
/**
 * Navigation fixe : logo, Accueil, Galeries, Prestations et bouton Contact.
 * Transparente au-dessus d'une grande photo, elle se pose sur un fond flouté dès qu'on défile.
 * Sur téléphone, les liens passent dans un panneau plein écran.
 */
import Icon from './Icon.astro';
import { CONTACT_LINK, NAV, isActive, site } from '@/lib/site';

const { pathname } = Astro.url;
---

<header class="header" data-header>
  <div class="header__inner">
    <a class="header__logo" href="/" aria-label={`${site.name} — accueil`}>
      <img src={site.logo} alt="" width="527" height="400" />
    </a>

    <nav class="header__nav" aria-label="Navigation principale">
      {
        NAV.map((item) => (
          <a class="header__link" href={item.href} aria-current={isActive(item.href, pathname) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
      <a class="btn btn--accent btn--small header__cta" href={CONTACT_LINK.href} aria-current={isActive(CONTACT_LINK.href, pathname) ? 'page' : undefined}>
        {CONTACT_LINK.label}
      </a>
    </nav>

    <button class="burger" type="button" aria-expanded="false" aria-controls="menu" data-burger>
      <span class="sr-only">Menu</span>
      <span class="burger__lines" aria-hidden="true"></span>
    </button>
  </div>
</header>

<div class="menu" id="menu" data-menu hidden>
  <nav class="menu__nav" aria-label="Menu">
    {
      NAV.map((item) => (
        <a class="menu__link" href={item.href} aria-current={isActive(item.href, pathname) ? 'page' : undefined}>
          {item.label}
        </a>
      ))
    }
  </nav>
  <a class="btn btn--accent menu__cta" href={CONTACT_LINK.href}>Me contacter <Icon name="arrow-right" /></a>
</div>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    padding-top: env(safe-area-inset-top, 0px);
    border-bottom: 1px solid transparent;
    transition:
      background-color 0.35s var(--ease),
      border-color 0.35s var(--ease);
  }
  .header.is-solid,
  :global(html.menu-open) .header,
  :global(body:not(.has-hero)) .header {
    background: rgba(11, 11, 13, 0.86);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    border-bottom-color: var(--line);
  }

  .header__inner {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    height: var(--nav-h);
    max-width: calc(var(--page-max) + 2 * var(--gutter));
    margin-inline: auto;
    padding-left: max(var(--gutter), var(--gutter-l));
    padding-right: max(var(--gutter), var(--gutter-r));
  }
  .header__logo {
    flex: none;
  }
  .header__logo img {
    width: auto;
    height: 2.9rem;
  }

  .header__nav {
    display: flex;
    align-items: center;
    gap: 1.9rem;
    margin-left: auto;
  }
  .header__link {
    padding-block: 0.5rem;
    border-bottom: 2px solid transparent;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.78);
    transition:
      color 0.2s var(--ease),
      border-color 0.2s var(--ease);
  }
  .header__link:hover {
    color: var(--text);
  }
  .header__link[aria-current='page'] {
    color: var(--text);
    border-bottom-color: var(--accent);
  }
  .header__cta {
    margin-left: 0.25rem;
  }

  .burger {
    display: none;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-left: auto;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: rgba(11, 11, 13, 0.4);
  }
  .burger__lines,
  .burger__lines::before,
  .burger__lines::after {
    display: block;
    width: 1.125rem;
    height: 2px;
    background: var(--text);
    transition:
      transform 0.25s var(--ease),
      background-color 0.25s var(--ease);
  }
  .burger__lines {
    position: relative;
  }
  .burger__lines::before,
  .burger__lines::after {
    content: '';
    position: absolute;
    left: 0;
  }
  .burger__lines::before {
    top: -6px;
  }
  .burger__lines::after {
    top: 6px;
  }
  .burger[aria-expanded='true'] .burger__lines {
    background: transparent;
  }
  .burger[aria-expanded='true'] .burger__lines::before {
    transform: translateY(6px) rotate(45deg);
  }
  .burger[aria-expanded='true'] .burger__lines::after {
    transform: translateY(-6px) rotate(-45deg);
  }

  .menu {
    position: fixed;
    inset: 0;
    z-index: 45;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.75rem;
    padding: calc(var(--header-h) + 1rem) var(--gutter-r) calc(2rem + env(safe-area-inset-bottom, 0px)) var(--gutter-l);
    background: var(--bg);
    animation: menu-in 0.3s var(--ease) both;
  }
  .menu[hidden] {
    display: none;
  }
  @keyframes menu-in {
    from {
      opacity: 0;
    }
  }
  .menu__nav {
    display: grid;
    gap: 0.25rem;
  }
  .menu__link {
    font-weight: 800;
    font-stretch: 112%;
    font-size: clamp(2.1rem, 10vw, 3.25rem);
    line-height: 1.15;
    text-transform: uppercase;
  }
  .menu__link[aria-current='page'] {
    color: var(--accent);
  }
  .menu__cta {
    align-self: flex-start;
  }

  @media (max-width: 900px) {
    .header__nav {
      display: none;
    }
    .burger {
      display: inline-grid;
    }
    .header__logo img {
      height: 2.5rem;
    }
  }
  @media (min-width: 901px) {
    .menu {
      display: none !important;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const burger = document.querySelector<HTMLButtonElement>('[data-burger]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');

  if (header) {
    const update = () => header.classList.toggle('is-solid', window.scrollY > 24);
    update();
    window.addEventListener('scroll', update, { passive: true });
  }

  if (burger && menu) {
    const label = burger.querySelector<HTMLElement>('.sr-only');
    const setOpen = (open: boolean) => {
      burger.setAttribute('aria-expanded', String(open));
      if (label) label.textContent = open ? 'Fermer le menu' : 'Menu';
      menu.hidden = !open;
      document.documentElement.classList.toggle('menu-open', open);
      document.body.classList.toggle('is-locked', open);
    };
    burger.addEventListener('click', () => setOpen(burger.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !menu.hidden) {
        setOpen(false);
        burger.focus();
      }
    });
    window.matchMedia('(min-width: 901px)').addEventListener('change', (event) => event.matches && setOpen(false));
  }
</script>
