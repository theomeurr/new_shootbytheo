---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CtaBand from '@/components/CtaBand.astro';
import Icon from '@/components/Icon.astro';
import Picture from '@/components/Picture.astro';
import { sitePhoto } from '@/lib/media';
import { instagram, site } from '@/lib/site';
import { fitDivisor } from '@/lib/type-metrics';
import about from '@content/a-propos.json';

const photo = sitePhoto(about.image);
// Le titre s'ajuste pour que son mot le plus long tienne dans la colonne.
const titleFit = fitDivisor(about.title.split(' '));
---

<BaseLayout title="À propos — derrière ShootByTheo" description={`${about.lead} ${about.paragraphs[0] ?? ''}`.trim().slice(0, 158)}>
  <section class="about container">
    <div class="about__media" data-reveal>
      {photo ? <Picture photo={photo} alt={about.imageAlt} sizes="(min-width: 1000px) 35vw, 100vw" cover position={about.imagePosition} priority max={2048} /> : <div class="about__placeholder" />}
    </div>

    <div class="about__body">
      <p class="kicker" data-reveal>À propos</p>
      <div class="fit" style={`--fit:${titleFit}`} data-reveal>
        <h1 class="display about__title">{about.title}</h1>
      </div>
      <p class="lead" data-reveal style="--reveal-delay:80ms">{about.lead}</p>
      <div class="prose" data-reveal style="--reveal-delay:140ms">
        {about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <p class="about__signature" data-reveal style="--reveal-delay:200ms">{about.signature}</p>

      <div class="about__actions" data-reveal style="--reveal-delay:240ms">
        <a class="btn btn--accent" href="/evenements/">Voir les événements <Icon name="arrow-right" /></a>
        {
          instagram && (
            <a class="link-arrow" href={instagram.url} target="_blank" rel="noopener">
              {instagram.handle} <Icon name="arrow-up-right" />
            </a>
          )
        }
      </div>
    </div>
  </section>

  <CtaBand kicker={site.tagline} title="Un projet ? Parlons-en." label="Me contacter" />
</BaseLayout>

<style>
  .about {
    display: grid;
    gap: clamp(2rem, 5vw, 6rem);
    align-items: center;
    padding-top: calc(var(--header-h) + clamp(1.5rem, 4vw, 4rem));
    padding-bottom: var(--section);
  }
  .about__media {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--bg-elev);
  }
  .about__placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #17171c, #0c0c0e);
  }
  .about__body {
    display: grid;
    justify-items: start;
    gap: clamp(1rem, 1.8vw, 1.75rem);
  }
  .about__title {
    font-size: clamp(1.4rem, calc(100cqi / (var(--fit) * 1.35)), 4.25rem);
  }
  .about__signature {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .about__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
    margin-top: 0.75rem;
  }
  @media (min-width: 1000px) {
    .about {
      grid-template-columns: minmax(0, 0.78fr) minmax(0, 1fr);
    }
    .about__media {
      max-height: calc(86svh - var(--header-h));
    }
  }
</style>
