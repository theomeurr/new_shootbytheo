---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CtaBand from '@/components/CtaBand.astro';
import Icon from '@/components/Icon.astro';
import PageHead from '@/components/PageHead.astro';
import Picture from '@/components/Picture.astro';
import { sitePhoto } from '@/lib/media';
import { absoluteUrl, site } from '@/lib/site';
import prestations from '@content/prestations.json';

const services = prestations.services.map((service) => ({ ...service, photo: sitePhoto(service.image) }));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.name,
  url: absoluteUrl('/prestations/'),
  email: site.email,
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Prestations photo et vidéo sportives',
    itemListElement: services.map((service) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: service.title, description: service.summary },
    })),
  },
};
---

<BaseLayout
  title="Prestations — reportage photo, vidéo et contenu sportif"
  description="Reportage photo sportif, vidéo, contenus pour les réseaux sociaux et couverture complète d’événement : les prestations ShootByTheo pour clubs, joueurs et organisateurs. Devis personnalisé."
  jsonLd={jsonLd}
>
  <PageHead kicker="Photo · Vidéo · Réseaux sociaux" title="Prestations" intro={prestations.intro} />

  <div class="container services">
    {
      services.map((service, index) => (
        <section class="service" id={service.id} aria-labelledby={`titre-${service.id}`} data-reveal style={`--reveal-delay:${index * 80}ms`}>
          <div class="service__media">
            {service.photo ? (
              <Picture photo={service.photo} alt="" sizes="(min-width: 700px) 22vw, 40vw" cover position={service.imagePosition} priority={index === 0} max={960} />
            ) : (
              <div class="service__placeholder" />
            )}
          </div>

          <div class="service__body">
            <h2 class="service__title" id={`titre-${service.id}`}>
              {service.title}
            </h2>
            <p class="service__summary">{service.summary}</p>
            <a class="service__cta" href={`/contact/?prestation=${encodeURIComponent(service.formValue)}`}>
              Demander un devis <Icon name="arrow-right" />
            </a>
          </div>
        </section>
      ))
    }
  </div>

  <div class="container">
    <p class="note" data-reveal>{prestations.quoteNote}</p>
  </div>

  <CtaBand kicker="Sur mesure" title="Un projet ? Parlons-en." text="Club, joueur, association, organisateur ou marque : décrivez-moi votre événement, je vous réponds avec une proposition adaptée." label="Demander un devis" />
</BaseLayout>

<style>
  .services {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    padding-block: clamp(1rem, 3vw, 3rem) var(--section);
  }
  .service {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    align-items: center;
    gap: clamp(1.25rem, 2.5vw, 2rem);
    padding-block: clamp(1.25rem, 2vw, 1.75rem);
    border-bottom: 1px solid var(--line);
  }
  .service__media {
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 2px;
    background: var(--bg-elev);
  }
  .service__placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #17171c, #0c0c0e);
  }
  .service__body {
    display: grid;
    justify-items: start;
    gap: 0.5rem;
  }
  .service__title {
    font-weight: 800;
    font-size: clamp(1.15rem, 1.4vw, 1.45rem);
  }
  .service__summary {
    max-width: 56ch;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--text-dim);
  }
  .service__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    margin-top: 0.35rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    transition: color 0.3s var(--ease);
  }
  .service__cta:hover {
    color: var(--accent-bright);
  }
  .service__cta :global(svg) {
    width: 1.1em;
    height: 1.1em;
  }

  @media (max-width: 600px) {
    .service {
      grid-template-columns: 3.5rem 1fr;
    }
  }

  .note {
    max-width: 60ch;
    margin-bottom: var(--section);
    padding-left: 1.5rem;
    border-left: 2px solid var(--accent);
    font-size: clamp(1rem, 0.4vw + 0.92rem, 1.2rem);
    line-height: 1.5;
    color: var(--text);
  }
</style>
