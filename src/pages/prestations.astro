---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CtaBand from '@/components/CtaBand.astro';
import Icon from '@/components/Icon.astro';
import PageHead from '@/components/PageHead.astro';
import Picture from '@/components/Picture.astro';
import { sitePhoto } from '@/lib/media';
import { absoluteUrl, site } from '@/lib/site';
import prestations from '@content/prestations.json';

const services = prestations.services.map((service) => ({ ...service, photo: sitePhoto(service.image) }));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.name,
  url: absoluteUrl('/prestations/'),
  email: site.email,
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Prestations photo et vidéo sportives',
    itemListElement: services.map((service) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: service.title, description: service.summary },
    })),
  },
};
---

<BaseLayout
  title="Prestations — reportage photo, vidéo et contenu sportif"
  description="Reportage photo sportif, vidéo, contenus pour les réseaux sociaux et couverture complète d’événement : les prestations ShootByTheo pour clubs, joueurs et organisateurs. Devis personnalisé."
  jsonLd={jsonLd}
>
  <PageHead kicker="Photo · Vidéo · Réseaux sociaux" title="Prestations" intro={prestations.intro} />

  <div class="container services">
    {
      services.map((service, index) => (
        <section class:list={['service', index % 2 === 1 && 'service--flip']} id={service.id} aria-labelledby={`titre-${service.id}`}>
          <div class="service__media" data-reveal>
            {service.photo ? (
              <Picture photo={service.photo} alt="" sizes="(min-width: 1000px) 42vw, 100vw" cover position={service.imagePosition} priority={index === 0} max={2048} />
            ) : (
              <div class="service__placeholder" />
            )}
            <span class="service__number" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
          </div>

          <div class="service__body" data-reveal style="--reveal-delay:120ms">
            <p class="kicker">Prestation {String(index + 1).padStart(2, '0')}</p>
            <h2 class="display service__title" id={`titre-${service.id}`}>
              {service.title}
            </h2>
            <p class="service__summary">{service.summary}</p>
            <ul class="service__list">
              {service.includes.map((item) => <li>{item}</li>)}
            </ul>
            <a class="btn btn--accent" href={`/contact/?prestation=${encodeURIComponent(service.formValue)}`}>
              Demander un devis <Icon name="arrow-right" />
            </a>
          </div>
        </section>
      ))
    }
  </div>

  <div class="container">
    <p class="note" data-reveal>{prestations.quoteNote}</p>
  </div>

  <CtaBand kicker="Sur mesure" title="Un projet ? Parlons-en." text="Club, joueur, association, organisateur ou marque : décrivez-moi votre événement, je vous réponds avec une proposition adaptée." label="Demander un devis" />
</BaseLayout>

<style>
  .services {
    display: grid;
    gap: clamp(4rem, 9vw, 10rem);
    padding-block: clamp(1rem, 3vw, 3rem) var(--section);
  }
  .service {
    display: grid;
    gap: clamp(1.75rem, 4vw, 5rem);
    align-items: center;
    scroll-margin-top: calc(var(--header-h) + 1.5rem);
  }
  .service__media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--bg-elev);
  }
  .service__placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #17171c, #0c0c0e);
  }
  .service__number {
    position: absolute;
    left: clamp(1rem, 1.6vw, 1.75rem);
    bottom: clamp(0.5rem, 1vw, 1rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    font-size: clamp(3.2rem, 7.8vw, 8.25rem);
    line-height: 0.8;
    color: transparent;
    -webkit-text-stroke: 1px rgba(243, 239, 233, 0.75);
  }
  .service__body {
    display: grid;
    justify-items: start;
    gap: clamp(1rem, 1.6vw, 1.6rem);
  }
  .service__title {
    font-size: clamp(1.6rem, 3.05vw, 3.3rem);
  }
  .service__summary {
    max-width: 46ch;
    font-size: clamp(1rem, 0.3vw + 0.92rem, 1.15rem);
    line-height: 1.55;
    color: var(--text-dim);
  }
  .service__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-block: 0.25rem 0.75rem;
  }
  .service__list li {
    padding: 0.5em 0.95em;
    border: 1px solid var(--line);
    font-size: 0.875rem;
    line-height: 1.3;
    color: var(--text-dim);
  }

  @media (min-width: 1000px) {
    .service {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    }
    .service--flip {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    }
    .service--flip .service__media {
      order: 2;
    }
    .service__media {
      aspect-ratio: 3 / 2;
    }
  }

  .note {
    max-width: 60ch;
    margin-bottom: var(--section);
    padding-left: 1.5rem;
    border-left: 2px solid var(--accent);
    font-size: clamp(1rem, 0.4vw + 0.92rem, 1.2rem);
    line-height: 1.5;
    color: var(--text);
  }
</style>
