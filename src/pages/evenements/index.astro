---
/**
 * Galeries : tous les reportages, filtrables par catégorie (content/categories/)
 * et triés par date, les plus récents en premier.
 * Le filtre est repris dans l'adresse (?categorie=top-12) pour pouvoir être partagé.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import EventCard from '@/components/EventCard.astro';
import Picture from '@/components/Picture.astro';
import { getCategories, getEvents } from '@/lib/events';
import { sitePhoto } from '@/lib/media';
import { absoluteUrl, site } from '@/lib/site';

const events = await getEvents();
const known = await getCategories();

// Catégories de l'administration, plus celles qui n'existeraient que dans un reportage.
const extra = events
  .map((event) => event.category)
  .filter((category, index, list) => category && !known.some((c) => c.id === category.id) && list.findIndex((c) => c?.id === category.id) === index);
const categories = [{ id: 'toutes', name: 'Toutes' }, ...known, ...(extra as typeof known)].map((category) => ({
  ...category,
  count: category.id === 'toutes' ? events.length : events.filter((event) => event.category?.id === category.id).length,
}));

const banner = sitePhoto(site.galleryBanner) ?? events[0]?.cover;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `Galeries — ${site.name}`,
  url: absoluteUrl('/evenements/'),
  inLanguage: 'fr-FR',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: events.map((event, index) => ({ '@type': 'ListItem', position: index + 1, url: absoluteUrl(event.url), name: event.title })),
  },
};
---

<BaseLayout
  title="Galeries — reportages photo de badminton"
  description={`Les reportages photo de ${site.name} : ${events.length} galeries de badminton (Top 12, Nationale 2, Pré-Nationale) et d’événements sportifs, journée par journée.`}
  jsonLd={jsonLd}
  bodyClass="has-hero"
>
  <section class="banner">
    {banner && <Picture photo={banner} alt="" sizes="100vw" cover position="50% 40%" priority />}
    <div class="banner__content container">
      <h1 class="display banner__title">Mes reportages</h1>
    </div>
  </section>

  <section class="container list">
    <div class="toolbar">
      <div class="filters" role="group" aria-label="Filtrer par catégorie">
        {
          categories.map((category, index) => (
            <button class:list={['chip', !category.count && 'is-empty']} type="button" data-filter={category.id} aria-pressed={index === 0 ? 'true' : 'false'}>
              {category.name} <small>{category.count}</small>
            </button>
          ))
        }
      </div>
      <label class="sort">
        Trier
        <select data-sort>
          <option value="recent">Plus récents</option>
          <option value="ancien">Plus anciens</option>
        </select>
      </label>
    </div>

    <p class="sr-only" role="status" aria-live="polite" data-status></p>

    <div class="grid" data-grid>
      {events.map((event, index) => <EventCard event={event} priority={index < 3} heading="h2" />)}
    </div>

    <div class="empty" data-empty hidden>
      <strong>Aucun reportage dans cette catégorie pour le moment.</strong>
      Les prochains apparaîtront ici dès leur publication.
    </div>
  </section>
</BaseLayout>

<style>
  .banner {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: min(62svh, 37.5rem);
    overflow: hidden;
    isolation: isolate;
  }
  .banner > :global(.picture) {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .banner::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, rgba(11, 11, 13, 0.6) 0%, rgba(11, 11, 13, 0.25) 40%, var(--bg) 100%);
  }
  .banner__content {
    display: grid;
    gap: 1.1rem;
    padding-top: calc(var(--header-h) + 5rem);
    padding-bottom: clamp(2.25rem, 5vw, 4rem);
  }
  .banner__title {
    font-size: clamp(2.1rem, 7vw, 7rem);
  }

  .list {
    padding-top: 1.75rem;
    padding-bottom: var(--section);
  }
  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.1rem;
    padding-bottom: 1.9rem;
    margin-bottom: clamp(1.75rem, 4vw, 2.75rem);
    border-bottom: 1px solid var(--line);
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .sort {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .sort select {
    padding: 0.55rem 2rem 0.55rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--bg-soft);
    color: var(--text);
  }
  .sort select:focus {
    outline: none;
    border-color: var(--accent);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.75rem, 2.4vw, 2.25rem) clamp(0.875rem, 1.6vw, 1.5rem);
  }
  .grid :global([data-card][hidden]) {
    display: none;
  }
  @media (max-width: 1100px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }

  .empty {
    padding: 3.5rem 1.5rem;
    border: 1px dashed var(--line);
    border-radius: var(--radius);
    text-align: center;
    color: var(--muted);
  }
  .empty strong {
    display: block;
    margin-bottom: 0.375rem;
    font-size: 1.125rem;
    color: var(--text);
  }
</style>

<script>
  const grid = document.querySelector<HTMLElement>('[data-grid]');
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const sort = document.querySelector<HTMLSelectElement>('[data-sort]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  const status = document.querySelector<HTMLElement>('[data-status]');

  if (grid && sort && empty) {
    const cards = [...grid.querySelectorAll<HTMLElement>('[data-card]')];
    const ids = new Set(buttons.map((button) => button.dataset.filter));
    let current = 'toutes';

    const apply = (pushUrl: boolean) => {
      let shown = 0;
      for (const card of cards) {
        const visible = current === 'toutes' || card.dataset.category === current;
        card.hidden = !visible;
        if (visible) {
          shown++;
          card.classList.add('is-visible'); // pas d'animation d'apparition en attente sur une carte filtrée
        }
      }
      buttons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.filter === current)));
      empty.hidden = shown > 0;
      if (status) status.textContent = `${shown} reportage${shown > 1 ? 's' : ''}`;
      if (pushUrl) {
        const url = new URL(location.href);
        if (current === 'toutes') url.searchParams.delete('categorie');
        else url.searchParams.set('categorie', current);
        history.replaceState(history.state, '', url);
      }
    };

    const order = () => {
      const direction = sort.value === 'ancien' ? 1 : -1;
      cards
        .sort((a, b) => direction * (a.dataset.date ?? '').localeCompare(b.dataset.date ?? ''))
        .forEach((card) => grid.append(card));
    };

    buttons.forEach((button) =>
      button.addEventListener('click', () => {
        current = button.dataset.filter ?? 'toutes';
        apply(true);
      }),
    );
    sort.addEventListener('change', order);

    const wanted = new URLSearchParams(location.search).get('categorie');
    if (wanted && ids.has(wanted)) {
      current = wanted;
      apply(false);
    }
  }
</script>
