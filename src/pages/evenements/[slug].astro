---
/**
 * Page d'un reportage : couverture, titre, description, fiche (date, lieu, rencontres, photos),
 * partage, téléchargement si autorisé, galerie masonry et visionneuse plein écran.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Gallery, { type GalleryItem } from '@/components/Gallery.astro';
import Icon from '@/components/Icon.astro';
import Lightbox from '@/components/Lightbox.astro';
import Picture from '@/components/Picture.astro';
import { getEvents, type SiteEvent } from '@/lib/events';
import { keepBullet } from '@/lib/dates';
import { closestWidth, fallbackFormat, photoUrl } from '@/lib/media';
import { absoluteUrl, instagram, site } from '@/lib/site';

export async function getStaticPaths() {
  const events = await getEvents();
  return events.map((event, index) => ({
    params: { slug: event.slug },
    // Liste du plus récent au plus ancien : l'événement « suivant » est plus récent.
    props: { event, newer: events[index - 1], older: events[index + 1] },
  }));
}

interface Props {
  event: SiteEvent;
  newer?: SiteEvent;
  older?: SiteEvent;
}

const { event, newer, older } = Astro.props;
const count = event.photos.length;
const pad = (n: number) => String(n).padStart(2, '0');

const items: GalleryItem[] = event.photos.map((photo, index) => ({
  photo,
  alt: `${event.seoTitle} — photo ${index + 1}`,
  download: event.download ? `${event.slug}-${pad(index + 1)}` : undefined,
}));

const facts = [
  { label: 'Date', value: event.dateLabel },
  { label: 'Lieu', value: [event.venue, event.location].filter(Boolean).join(', ') },
  { label: 'Compétition', value: event.competition || event.type },
  { label: event.matches.length > 1 ? 'Rencontres' : 'Rencontre', value: event.matches.join('\n') },
].filter((fact) => fact.value);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ImageGallery',
    name: event.seoTitle,
    description: event.seoDescription,
    url: absoluteUrl(event.url),
    datePublished: event.isoDate,
    inLanguage: 'fr-FR',
    author: { '@type': 'Person', name: 'Théo Meurier', url: absoluteUrl('/') },
    copyrightHolder: { '@type': 'Person', name: 'Théo Meurier' },
    about: {
      '@type': 'SportsEvent',
      name: event.title,
      startDate: event.isoDate,
      ...(event.sport ? { sport: event.sport } : {}),
      ...(event.location ? { location: { '@type': 'Place', name: [event.venue, event.location].filter(Boolean).join(', ') } } : {}),
    },
    image: event.photos.slice(0, 12).map((photo) => ({
      '@type': 'ImageObject',
      contentUrl: absoluteUrl(photoUrl(photo, closestWidth(photo, 2048), fallbackFormat(photo))),
      width: photo.w,
      height: photo.h,
      creditText: site.name,
      creator: { '@type': 'Person', name: 'Théo Meurier' },
      copyrightNotice: `© ${site.name}`,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: absoluteUrl('/') },
      { '@type': 'ListItem', position: 2, name: 'Galeries', item: absoluteUrl('/evenements/') },
      { '@type': 'ListItem', position: 3, name: event.title, item: absoluteUrl(event.url) },
    ],
  },
];
---

<BaseLayout title={event.seoTitle} description={event.seoDescription} image={event.ogImage} imageAlt={event.seoTitle} type="article" jsonLd={jsonLd} bodyClass="has-hero">
  <article>
    <header class="cover">
      {event.cover && <Picture photo={event.cover} alt="" sizes="100vw" cover position={event.coverPosition} priority />}
      <div class="cover__content container">
        <nav class="crumbs" aria-label="Fil d’Ariane">
          <a href="/evenements/">Galeries</a>
          {
            event.category && (
              <>
                <span aria-hidden="true">/</span>
                <a href={`/evenements/?categorie=${event.category.id}`}>{event.category.name}</a>
              </>
            )
          }
        </nav>
        <h1 class="display cover__title" data-lb-heading={event.title}>{keepBullet(event.title)}</h1>
        <p class="cover__meta">
          <time datetime={event.isoDate}>{event.dateLabel}</time>
          {event.location && <span>· {event.location}</span>}
          {count > 0 && <span class="cover__count">· {count} photo{count > 1 ? 's' : ''}</span>}
        </p>
      </div>
    </header>

    <section class="container story">
      <div class="story__text" data-reveal>
        {event.description && <p class="story__lead">{event.description}</p>}
        <div class="actions">
          <button class="btn btn--quiet" type="button" data-share data-title={event.title}>
            Partager la galerie <Icon name="share" />
          </button>
          {
            event.download && event.downloadUrl && (
              <a class="btn btn--accent" href={event.downloadUrl} target="_blank" rel="noopener">
                Télécharger les photos <Icon name="download" />
              </a>
            )
          }
        </div>
        {
          event.download ? (
            <p class="note">
              Photos à télécharger librement. Merci de créditer <strong>{instagram?.handle ?? site.name}</strong>.
            </p>
          ) : (
            <p class="note">
              Pour utiliser ces photos, <a href="/contact/">écrivez-moi</a>.
            </p>
          )
        }
        <p class="toast" role="status" aria-live="polite" data-share-status hidden></p>
      </div>

      <dl class="facts" data-reveal style="--reveal-delay:80ms">
        {
          facts.map((fact) => (
            <>
              <dt>{fact.label}</dt>
              <dd>{fact.value}</dd>
            </>
          ))
        }
      </dl>
    </section>

    <section class="container photos" aria-label="Photos du reportage">
      {count > 0 ? <Gallery items={items} group={event.slug} eager={3} /> : <p class="note">Les photos arrivent bientôt.</p>}
    </section>

    {
      (newer || older) && (
        <nav class="container siblings" aria-label="Autres reportages">
          {newer ? (
            <a class="sibling" href={newer.url}>
              {newer.cover && <Picture photo={newer.cover} alt="" sizes="(min-width: 700px) 50vw, 100vw" cover position={newer.coverPosition} max={1440} />}
              <span class="sibling__content">
                <span class="kicker">← Plus récent</span>
                <strong>{keepBullet(newer.title)}</strong>
              </span>
            </a>
          ) : (
            <span />
          )}
          {older ? (
            <a class="sibling sibling--right" href={older.url}>
              {older.cover && <Picture photo={older.cover} alt="" sizes="(min-width: 700px) 50vw, 100vw" cover position={older.coverPosition} max={1440} />}
              <span class="sibling__content">
                <span class="kicker">Plus ancien →</span>
                <strong>{keepBullet(older.title)}</strong>
              </span>
            </a>
          ) : (
            <span />
          )}
        </nav>
      )
    }
  </article>

  <Lightbox />
</BaseLayout>

<style>
  .cover {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: min(78svh, 51rem);
    overflow: hidden;
    isolation: isolate;
  }
  .cover > :global(.picture) {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .cover::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, rgba(11, 11, 13, 0.55) 0%, rgba(11, 11, 13, 0.15) 35%, rgba(11, 11, 13, 0.5) 65%, var(--bg) 100%);
  }
  .cover__content {
    display: grid;
    gap: 1.1rem;
    padding-top: calc(var(--header-h) + 5rem);
    padding-bottom: clamp(2rem, 4vw, 3.5rem);
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.7);
  }
  .crumbs a:hover {
    color: var(--accent);
  }
  .cover__title {
    font-size: clamp(2rem, 6.6vw, 6.5rem);
  }
  .cover__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .cover__count {
    color: var(--text);
  }

  .story {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    align-items: start;
    gap: clamp(1.75rem, 5vw, 5rem);
    padding-block: clamp(2.25rem, 5vw, 4rem);
  }
  .story__lead {
    max-width: 44ch;
    font-size: clamp(1.125rem, 1.6vw, 1.375rem);
    line-height: 1.55;
    text-wrap: pretty;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin-top: 1.25rem;
  }
  .note {
    max-width: 60ch;
    margin-top: 0.875rem;
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .note a,
  .note strong {
    color: var(--text);
  }
  .note a {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.2em;
  }
  .toast {
    margin-top: 0.75rem;
    font-size: 0.8125rem;
    color: var(--accent);
  }
  .facts {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.75rem 1.4rem;
    padding: 1.4rem 1.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-soft);
  }
  .facts dt {
    padding-top: 0.2rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .facts dd {
    margin: 0;
    font-weight: 600;
    white-space: pre-line;
  }
  @media (max-width: 860px) {
    .story {
      grid-template-columns: 1fr;
    }
  }

  .photos {
    padding-bottom: clamp(4rem, 8vw, 7rem);
  }

  .siblings {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(0.75rem, 1.5vw, 1.25rem);
    padding-bottom: clamp(4rem, 8vw, 7rem);
  }
  .sibling {
    position: relative;
    display: block;
    aspect-ratio: 21 / 9;
    border-radius: var(--radius);
    overflow: hidden;
    isolation: isolate;
    background: var(--bg-soft);
  }
  .sibling :global(.picture) {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .sibling :global(img) {
    transition:
      transform 1s var(--ease),
      opacity 0.8s ease;
  }
  .sibling::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgba(11, 11, 13, 0.62);
  }
  .sibling__content {
    position: absolute;
    inset: auto 0 0;
    display: grid;
    gap: 0.375rem;
    padding: clamp(1rem, 2vw, 1.6rem);
  }
  .sibling__content strong {
    font-weight: 800;
    font-stretch: 108%;
    font-size: clamp(1.125rem, 1.8vw, 1.6rem);
    line-height: 1.05;
    text-transform: uppercase;
  }
  .sibling--right .sibling__content {
    text-align: right;
  }
  @media (hover: hover) {
    .sibling:hover :global(img) {
      transform: scale(1.05);
    }
  }
  @media (max-width: 700px) {
    .siblings {
      grid-template-columns: 1fr;
    }
    .sibling--right .sibling__content {
      text-align: left;
    }
  }
</style>

<script>
  // Partager : feuille de partage du téléphone, sinon copie du lien.
  const button = document.querySelector<HTMLButtonElement>('[data-share]');
  const status = document.querySelector<HTMLElement>('[data-share-status]');
  const say = (text: string) => {
    if (!status) return;
    status.textContent = text;
    status.hidden = false;
    window.setTimeout(() => (status.hidden = true), 4000);
  };
  button?.addEventListener('click', async () => {
    const url = location.origin + location.pathname;
    const title = button.dataset.title ?? document.title;
    if (navigator.share) {
      try {
        await navigator.share({ title, url });
        return;
      } catch (error) {
        if ((error as DOMException).name === 'AbortError') return;
      }
    }
    try {
      await navigator.clipboard.writeText(url);
      say('Lien de la galerie copié.');
    } catch {
      window.prompt('Copiez le lien de la galerie :', url);
    }
  });
</script>
