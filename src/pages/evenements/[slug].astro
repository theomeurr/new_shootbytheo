---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CtaBand from '@/components/CtaBand.astro';
import Gallery, { type GalleryItem } from '@/components/Gallery.astro';
import Icon from '@/components/Icon.astro';
import Lightbox from '@/components/Lightbox.astro';
import Picture from '@/components/Picture.astro';
import { getEvents, type SiteEvent } from '@/lib/events';
import { closestWidth, fallbackFormat, photoUrl } from '@/lib/media';
import { absoluteUrl, site } from '@/lib/site';

export async function getStaticPaths() {
  const events = await getEvents();
  return events.map((event, index) => ({
    params: { slug: event.slug },
    // Liste du plus récent au plus ancien : l'événement « suivant » est plus récent.
    props: { event, newer: events[index - 1], older: events[index + 1] },
  }));
}

interface Props {
  event: SiteEvent;
  newer?: SiteEvent;
  older?: SiteEvent;
}

const { event, newer, older } = Astro.props;
const count = event.photos.length;
// « Pré-Nationale • Journée 1 » : une ligne par partie, la puce ne sert plus que de séparateur sémantique.
const titleParts = event.title
  .split(/[•|]/)
  .map((part) => part.trim())
  .filter(Boolean);

const items: GalleryItem[] = event.photos.map((photo, index) => ({
  photo,
  alt: `${event.seoTitle} — photo ${index + 1}`,
}));

const facts = [
  { label: 'Date', value: event.dateLabel },
  { label: 'Lieu', value: [event.venue, event.location].filter(Boolean).join(', ') },
  { label: 'Compétition', value: event.competition || event.type },
  { label: event.teams.length > 2 ? 'Participants' : 'Équipes', value: event.teams.join(' · ') },
].filter((fact) => fact.value);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ImageGallery',
    name: event.seoTitle,
    description: event.seoDescription,
    url: absoluteUrl(event.url),
    datePublished: event.isoDate,
    inLanguage: 'fr-FR',
    author: { '@type': 'Organization', name: site.name, url: absoluteUrl('/') },
    copyrightHolder: { '@type': 'Organization', name: site.name },
    about: {
      '@type': 'SportsEvent',
      name: event.title,
      startDate: event.isoDate,
      ...(event.sport ? { sport: event.sport } : {}),
      ...(event.location ? { location: { '@type': 'Place', name: [event.venue, event.location].filter(Boolean).join(', ') } } : {}),
    },
    image: event.photos.slice(0, 12).map((photo) => ({
      '@type': 'ImageObject',
      contentUrl: absoluteUrl(photoUrl(photo, closestWidth(photo, 2048), fallbackFormat(photo))),
      width: photo.w,
      height: photo.h,
      creditText: site.name,
      creator: { '@type': 'Organization', name: site.name },
      copyrightNotice: `© ${site.name}`,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: absoluteUrl('/') },
      { '@type': 'ListItem', position: 2, name: 'Événements', item: absoluteUrl('/evenements/') },
      { '@type': 'ListItem', position: 3, name: event.title, item: absoluteUrl(event.url) },
    ],
  },
];
---

<BaseLayout title={event.seoTitle} description={event.seoDescription} image={event.ogImage} imageAlt={event.seoTitle} type="article" jsonLd={jsonLd}>
  <article>
    <header class="cover">
      {
        event.cover && (
          <div class="cover__media">
            <Picture photo={event.cover} alt={`${event.seoTitle} — photo de couverture`} sizes="100vw" cover position={event.coverPosition} priority />
          </div>
        )
      }
      <div class="cover__shade" aria-hidden="true"></div>

      <div class="cover__inner">
        <nav class="cover__crumbs" aria-label="Fil d’Ariane">
          <a href="/evenements/"><Icon name="arrow-left" /> Événements</a>
          <span aria-hidden="true">/</span>
          <span>{event.season}</span>
        </nav>
        {event.tag && <p class="kicker">{event.tag}</p>}
        <h1 class="display cover__title">
          {titleParts.map((part, index) => (
            <Fragment>
              {index > 0 && <span class="sr-only"> • </span>}
              <span class="cover__line">{part}</span>
            </Fragment>
          ))}
        </h1>
        <p class="cover__meta">
          <time datetime={event.isoDate}>{event.dateLabel}</time>
          {event.location && <span>{event.location}</span>}
          {count > 0 && <span>{count} photo{count > 1 ? 's' : ''}</span>}
        </p>
      </div>
    </header>

    <section class="container details" data-reveal>
      <dl class="facts">
        {
          facts.map((fact) => (
            <div class="facts__item">
              <dt class="meta">{fact.label}</dt>
              <dd>{fact.value}</dd>
            </div>
          ))
        }
      </dl>
      {event.description && <p class="lead details__text">{event.description}</p>}
    </section>

    <section class="container gallery" aria-label="Galerie photo">
      {
        count > 0 ? (
          <Gallery items={items} group="evenement" eager={4} />
        ) : (
          <p class="gallery__empty">Les photos de cet événement arrivent très bientôt.</p>
        )
      }
    </section>
  </article>

  {
    (newer || older) && (
      <nav class="container siblings" aria-label="Autres événements">
        {older ? (
          <a class="siblings__link" href={older.url} rel="prev">
            <span class="meta"><Icon name="arrow-left" /> Événement précédent</span>
            <span class="siblings__title">{older.title}</span>
            <span class="siblings__sub">{older.dateLabel}{older.location && ` · ${older.location}`}</span>
          </a>
        ) : (
          <span />
        )}
        {newer && (
          <a class="siblings__link siblings__link--next" href={newer.url} rel="next">
            <span class="meta">Événement suivant <Icon name="arrow-right" /></span>
            <span class="siblings__title">{newer.title}</span>
            <span class="siblings__sub">{newer.dateLabel}{newer.location && ` · ${newer.location}`}</span>
          </a>
        )}
      </nav>
    )
  }

  <CtaBand />
  <Lightbox />
</BaseLayout>

<style>
  .cover {
    position: relative;
    height: 76svh;
    min-height: 28rem;
    max-height: 60rem;
    overflow: hidden;
    isolation: isolate;
    background: var(--bg-elev);
  }
  .cover__media,
  .cover__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .cover__media :global(img) {
    animation: cover-settle 2.4s var(--ease-out) both;
  }
  @keyframes cover-settle {
    from {
      transform: scale(1.06);
    }
  }
  .cover__shade {
    background: linear-gradient(to top, rgba(10, 10, 11, 0.96) 0%, rgba(10, 10, 11, 0.5) 30%, rgba(10, 10, 11, 0) 62%);
  }
  .cover__inner {
    position: absolute;
    inset: auto 0 0;
    display: grid;
    gap: clamp(0.75rem, 1.4vw, 1.4rem);
    padding: 0 var(--edge) clamp(1.75rem, 3vw, 3rem);
  }
  .cover__crumbs {
    display: flex;
    align-items: center;
    gap: 0.9em;
    margin-bottom: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  .cover__crumbs a {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    padding-block: 0.4rem;
    color: var(--text);
    transition: color 0.3s var(--ease);
  }
  .cover__crumbs a:hover {
    color: var(--accent-bright);
  }
  .cover__crumbs :global(svg) {
    width: 1.2em;
    height: 1.2em;
  }
  .cover__line {
    display: block;
  }
  .cover__title {
    max-width: 18ch;
    margin-left: -0.04em;
    font-size: clamp(1.8rem, 4.5vw, 4.5rem);
  }
  .cover__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0;
    font-size: clamp(0.9375rem, 0.4vw + 0.85rem, 1.125rem);
    color: var(--text-dim);
  }
  .cover__meta span::before {
    content: '·';
    margin-inline: 0.7em;
    color: var(--accent);
  }

  .details {
    display: grid;
    gap: clamp(2rem, 4vw, 4rem);
    padding-block: clamp(2.5rem, 5vw, 5rem);
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 1.5rem 2rem;
  }
  .facts__item {
    display: grid;
    gap: 0.45rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }
  .facts__item dd {
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.4;
  }
  .details__text {
    max-width: 48ch;
    color: var(--text-dim);
  }
  @media (min-width: 1000px) {
    .details {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      align-items: start;
    }
  }

  .gallery {
    padding-bottom: var(--section);
  }
  .gallery__empty {
    padding-block: 5rem;
    text-align: center;
    color: var(--muted);
  }

  .siblings {
    display: grid;
    gap: 0;
    margin-bottom: var(--section);
    border-block: 1px solid var(--line);
  }
  .siblings__link {
    display: grid;
    gap: 0.5rem;
    padding-block: clamp(1.5rem, 3vw, 2.75rem);
    transition: color 0.3s var(--ease);
  }
  .siblings__link + .siblings__link {
    border-top: 1px solid var(--line);
  }
  .siblings__link .meta {
    display: inline-flex;
    align-items: center;
    gap: 0.7em;
  }
  .siblings__link :global(svg) {
    width: 1.3em;
    height: 1.3em;
    color: var(--accent);
    transition: transform 0.4s var(--ease-out);
  }
  .siblings__title {
    font-weight: 900;
    font-size: clamp(1.2rem, 2.1vw, 2.05rem);
    line-height: 1.05;
    letter-spacing: -0.025em;
    text-transform: uppercase;
  }
  .siblings__sub {
    font-size: 0.9375rem;
    color: var(--muted);
  }
  .siblings__link:hover .siblings__title {
    color: var(--accent-bright);
  }
  .siblings__link:hover :global(svg) {
    transform: translateX(-0.3em);
  }
  .siblings__link--next:hover :global(svg) {
    transform: translateX(0.3em);
  }
  @media (min-width: 800px) {
    .siblings {
      grid-template-columns: 1fr 1fr;
    }
    .siblings__link + .siblings__link {
      border-top: 0;
      border-left: 1px solid var(--line);
    }
    .siblings__link--next {
      justify-items: end;
      padding-left: 2rem;
      text-align: right;
    }
    .siblings__link:not(.siblings__link--next) {
      padding-right: 2rem;
    }
  }
</style>
